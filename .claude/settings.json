{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv sync:*)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(uv run locust:*)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror *)",
      "Bash(git filter-branch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python_style_read.py\"",
            "timeout": 15,
            "statusMessage": "Checking python-style.md was read..."
          }
        ]
      }
    ]
  }
}
